#!/usr/bin/env bash

# Back up this machine's paths to S3, encrypted with age, or restore a
# backup into an empty directory.
#
#   backup                      pack, encrypt and upload this machine's paths
#   backup restore <dir> [--host H] [version-id] [--profile P]
#   backup setup [--profile P]  create, or find in place, the bucket, this
#                               machine's IAM user and the backup profile

set -uo pipefail

# The public half of the backup key. Its private half lives only in the
# password manager and is typed in at restore.
AGE_PUBLIC_KEY=''
AGE_KEY_MISSING="bin/backup has no age public key; create a key pair with age-keygen, keep the secret key only in the password manager, and put the public key into AGE_PUBLIC_KEY at the top of bin/backup"

BUCKET='jorgenschaefer-backup'
REGION='eu-central-1'
UPLOAD_PROFILE='backup'

# Paths relative to $HOME. A pattern that matches nothing is not
# missing; every other path must exist.
COMMON_PATHS=(
  Documents
  .ssh
  .aws
  .local/share/keyrings
  '.claude/projects/*/memory'
)
NJORD_PATHS=(
  .myinvoice
  Projects/haushaltsbuch/haushaltsbuch.db
)

# SQLite databases, relative to $HOME. One that lies within a host's
# paths is packed as a snapshot under its own name, never as the live
# file with its -wal and -shm.
SQLITE_DATABASES=(
  .myinvoice/myinvoice.db
  Projects/haushaltsbuch/haushaltsbuch.db
)

object_key () {
  local host="$1"
  echo "$host/backup.tar.age"
}

main () {
  case "${1:-}" in
    "") run_backup ;;
    restore) shift; restore "$@" ;;
    setup) shift; setup "$@" ;;
    *) usage ;;
  esac
}

run_backup () {
  local host listing paths work
  if [[ -z $AGE_PUBLIC_KEY ]]
  then
    fail backup_failed public_key_missing "" "$AGE_KEY_MISSING"
  fi
  host="$(hostname -s)"
  # backed_up_paths has already reported why when it fails.
  listing="$(backed_up_paths "$host")" || exit 1
  if ! aws configure get aws_access_key_id --profile "$UPLOAD_PROFILE" > /dev/null 2>&1
  then
    fail backup_failed profile_missing "" \
         "AWS profile $UPLOAD_PROFILE holds no access key; run backup setup with an admin profile"
  fi
  mapfile -t paths <<< "$listing"
  work="$(mktemp -d "$XDG_RUNTIME_DIR/backup.XXXXXX")"
  # shellcheck disable=SC2064 # $work is fixed by now
  trap "rm -rf '$work'" EXIT
  pack "$work" "${paths[@]}"
  age -r "$AGE_PUBLIC_KEY" -o "$work/backup.tar.age" "$work/backup.tar.gz" \
    || fail backup_failed encrypt_failed "" "could not encrypt the archive, see age's error above"
  upload "$work/backup.tar.age" "$(object_key "$host")"
  record_time last-backup
}

# Download a version of a host's object, decrypt it with the private
# key the user types in, and unpack it into an empty directory.
restore () {
  local dir="" host="" version="" profile="default" key work restored
  local -a version_option=()
  while [[ $# -gt 0 ]]
  do
    case "$1" in
      --host) host="${2:?--host needs a hostname}"; shift 2 ;;
      --profile) profile="${2:?--profile needs an AWS profile name}"; shift 2 ;;
      -*) usage ;;
      *)
        if [[ -z $dir ]]
        then
          dir="$1"
        elif [[ -z $version ]]
        then
          version="$1"
          version_option=(--version-id "$version")
        else
          usage
        fi
        shift
        ;;
    esac
  done
  [[ -n $dir ]] || usage
  local host_hint=""
  if [[ -z $host ]]
  then
    host="$(hostname -s)"
    host_hint="; to restore another machine's backup, name it with --host"
  fi
  if [[ -e $dir && -n $(ls -A -- "$dir") ]]
  then
    fail restore_failed directory_not_empty "dir=$dir" \
         "$dir is not empty; restore into an empty or a new directory"
  fi
  mkdir -p "$dir" \
    || fail restore_failed directory_unusable "dir=$dir" \
            "could not create $dir, see mkdir's error above"
  if [[ ! -w $dir ]]
  then
    fail restore_failed directory_unusable "dir=$dir" \
         "can't write into $dir; restore into a directory you can write"
  fi
  read -rsp "Age private key: " key
  echo >&2
  work="$(mktemp -d "$XDG_RUNTIME_DIR/backup.XXXXXX")"
  # shellcheck disable=SC2064 # $work is fixed by now
  trap "rm -rf '$work'" EXIT
  restored="$(aws s3api get-object --bucket "$BUCKET" \
                 --key "$(object_key "$host")" "${version_option[@]}" \
                 --profile "$profile" --region "$REGION" \
                 --query VersionId --output text "$work/backup.tar.age")" \
    || fail restore_failed download_failed "key=$(object_key "$host")" \
            "could not download $(object_key "$host") with AWS profile $profile, see aws's error above$host_hint"
  # The key reaches age through a pipe, so it is never written to disk.
  age -d -i <(echo "$key") "$work/backup.tar.age" | tar -xzf - -C "$dir" \
    || fail restore_failed unpack_failed "dir=$dir" \
            "could not decrypt and unpack into $dir, see the error above; was it the right key?"
  echo "Restored version $restored of $host's backup into $dir"
  record_time last-restore
}

# Create, or find already in place, what a run uploads with: the
# bucket and its settings, this machine's IAM user with its put-only
# policy, and the backup profile holding that user's key. Uses the
# admin credentials of the given profile.
setup () {
  local profile="default"
  while [[ $# -gt 0 ]]
  do
    case "$1" in
      --profile) profile="${2:?--profile needs an AWS profile name}"; shift 2 ;;
      *) usage ;;
    esac
  done
  local host user
  host="$(hostname -s)"
  user="backup-$host"
  set_up_bucket "$profile"
  set_bucket_settings "$profile"
  set_up_machine_user "$profile" "$user" "$host"
  set_up_upload_profile "$profile" "$user"
  if [[ -z $AGE_PUBLIC_KEY ]]
  then
    echo "Before the first run: $AGE_KEY_MISSING"
  fi
}

# Create the bucket if it is not there yet.
set_up_bucket () {
  local profile="$1" found
  found="$(aws s3api list-buckets --query "Buckets[?Name=='$BUCKET'].Name" \
               --output text --profile "$profile" --region "$REGION")" \
    || fail setup_failed bucket_unreadable "" \
            "could not list the buckets with AWS profile $profile, see aws's error above"
  if [[ $found == "$BUCKET" ]]
  then
    echo "Bucket $BUCKET was already there"
    return
  fi
  aws s3api create-bucket --bucket "$BUCKET" \
      --create-bucket-configuration "LocationConstraint=$REGION" \
      --profile "$profile" --region "$REGION" > /dev/null \
    || fail setup_failed bucket_create_failed "" \
            "could not create bucket $BUCKET with AWS profile $profile, see aws's error above"
  echo "Created bucket $BUCKET in $REGION"
}

# Put the bucket's settings, whether or not they are already in place:
# putting the same settings again changes nothing. The retention rule
# expires a version only once it has been superseded for 30 days and 90
# newer noncurrent versions exist, counted per object, so a stopped
# timer or a burst of uploads never empties a machine's history. It
# never touches the current version.
set_bucket_settings () {
  local profile="$1"
  local retention='{"Rules": [{"ID": "keep-90-versions-for-30-days", "Status": "Enabled", "Filter": {"Prefix": ""}, "NoncurrentVersionExpiration": {"NoncurrentDays": 30, "NewerNoncurrentVersions": 90}}]}'
  aws s3api put-bucket-versioning --bucket "$BUCKET" \
      --versioning-configuration Status=Enabled \
      --profile "$profile" --region "$REGION" \
    || fail setup_failed bucket_settings_failed "setting=versioning" \
            "could not turn on versioning for bucket $BUCKET, see aws's error above"
  aws s3api put-bucket-lifecycle-configuration --bucket "$BUCKET" \
      --lifecycle-configuration "$retention" \
      --profile "$profile" --region "$REGION" \
    || fail setup_failed bucket_settings_failed "setting=lifecycle" \
            "could not put the retention rule on bucket $BUCKET, see aws's error above"
  aws s3api put-public-access-block --bucket "$BUCKET" \
      --public-access-block-configuration "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true" \
      --profile "$profile" --region "$REGION" \
    || fail setup_failed bucket_settings_failed "setting=public_access_block" \
            "could not block public access to bucket $BUCKET, see aws's error above"
  aws s3api put-bucket-encryption --bucket "$BUCKET" \
      --server-side-encryption-configuration '{"Rules": [{"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]}' \
      --profile "$profile" --region "$REGION" \
    || fail setup_failed bucket_settings_failed "setting=encryption" \
            "could not turn on SSE-S3 encryption for bucket $BUCKET, see aws's error above"
  echo "Bucket $BUCKET has versioning, the retention rule (NoncurrentDays=30, NewerNoncurrentVersions=90), public access blocked and SSE-S3 encryption"
}

# Create the machine's IAM user if it is not there yet, and put its
# policy. The policy grants s3:PutObject on the machine's own object and
# nothing else. It must never grant reading, listing or deleting: these
# credentials sit on the laptop, and whoever holds the laptop would
# then read every machine's backups or wipe every version of them.
# Verifying a backup automatically is not worth that; restore with
# admin credentials instead.
set_up_machine_user () {
  local profile="$1" user="$2" host="$3" found policy
  found="$(aws iam list-users --query "Users[?UserName=='$user'].UserName" \
               --output text --profile "$profile" --region "$REGION")" \
    || fail setup_failed user_unreadable "user=$user" \
            "could not list the IAM users with AWS profile $profile, see aws's error above"
  if [[ $found == "$user" ]]
  then
    echo "IAM user $user was already there"
  else
    aws iam create-user --user-name "$user" \
        --profile "$profile" --region "$REGION" > /dev/null \
      || fail setup_failed user_create_failed "user=$user" \
              "could not create IAM user $user with AWS profile $profile, see aws's error above"
    echo "Created IAM user $user"
  fi
  policy='{"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::'"$BUCKET/$(object_key "$host")"'"}]}'
  aws iam put-user-policy --user-name "$user" --policy-name put-own-backup \
      --policy-document "$policy" --profile "$profile" --region "$REGION" \
    || fail setup_failed policy_failed "user=$user" \
            "could not put the policy of IAM user $user, see aws's error above"
  echo "IAM user $user may only put s3://$BUCKET/$(object_key "$host")"
}

# Make sure the profile a run uploads with holds an access key of the
# machine's IAM user. If it does not, write a new key into it.
set_up_upload_profile () {
  local profile="$1" user="$2" listed held created id secret
  local -a keys
  listed="$(aws iam list-access-keys --user-name "$user" \
                --query 'AccessKeyMetadata[].AccessKeyId' --output text \
                --profile "$profile" --region "$REGION")" \
    || fail setup_failed key_list_failed "user=$user" \
            "could not list the access keys of IAM user $user, see aws's error above"
  read -ra keys <<< "$listed"
  # A missing profile is the case this handles, not an error.
  held="$(aws configure get aws_access_key_id --profile "$UPLOAD_PROFILE" 2>/dev/null)"
  if [[ -n $held && " ${keys[*]} " == *" $held "* ]]
  then
    echo "Profile $UPLOAD_PROFILE already holds access key $held of IAM user $user"
    return
  fi
  # Keys the profile does not hold are lost or stolen, and an IAM user
  # can have only two, so they go before the new one is created.
  if [[ ${#keys[@]} -gt 0 ]]
  then
    for id in "${keys[@]}"
    do
      aws iam delete-access-key --user-name "$user" --access-key-id "$id" \
          --profile "$profile" --region "$REGION" \
        || fail setup_failed key_revoke_failed "user=$user key=$id" \
                "could not revoke access key $id of IAM user $user, see aws's error above"
    done
    echo "Revoked the old access keys of IAM user $user: ${keys[*]}"
  fi
  created="$(aws iam create-access-key --user-name "$user" \
                 --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text \
                 --profile "$profile" --region "$REGION")" \
    || fail setup_failed key_create_failed "user=$user" \
            "could not create an access key for IAM user $user, see aws's error above"
  read -r id secret <<< "$created"
  # The id goes in last: a profile with the id is taken as complete, so
  # one left half-written by a failure here is replaced by the next setup.
  if ! { aws configure set aws_secret_access_key "$secret" \
             --profile "$UPLOAD_PROFILE" \
           && aws configure set aws_access_key_id "$id" --profile "$UPLOAD_PROFILE"; }
  then
    fail setup_failed profile_failed "user=$user key=$id" \
         "could not write access key $id of $user into AWS profile $UPLOAD_PROFILE, see aws's error above; run setup again to replace the key"
  fi
  echo "Created profile $UPLOAD_PROFILE with access key $id of IAM user $user"
}

# The paths this host backs up, relative to $HOME, with the patterns
# expanded. Fails the run if a path that is not a pattern is missing.
backed_up_paths () {
  local host="$1" path
  local -a listed=("${COMMON_PATHS[@]}")
  case "$host" in
    njord) listed+=("${NJORD_PATHS[@]}") ;;
  esac
  cd "$HOME" || exit 1
  shopt -s nullglob
  for path in "${listed[@]}"
  do
    if [[ $path == *[*?[]* ]]
    then
      local match
      # The expansion is the point; nullglob makes no match no path.
      # shellcheck disable=SC2231
      for match in $path
      do
        echo "$match"
      done
    elif [[ -e $path ]]
    then
      echo "$path"
    else
      fail backup_failed path_missing "path=$path" \
           "$HOME/$path is missing; restore it, or remove it from the paths at the top of bin/backup"
    fi
  done
}

# Pack the paths into $work/backup.tar.gz, with the databases among
# them as snapshots. tar's excludes match every member name, so the
# snapshots are appended by a second tar.
pack () {
  local work="$1"; shift
  local -a databases excludes=()
  local db
  mapfile -t databases < <(databases_within "$@")
  for db in "${databases[@]}"
  do
    snapshot_database "$db" "$work/snapshots"
    excludes+=(--exclude="$db" --exclude="$db-wal" --exclude="$db-shm"
               --exclude="$db-journal")
  done
  tar -cf "$work/backup.tar" -C "$HOME" --anchored --no-wildcards \
      "${excludes[@]}" -- "$@" \
    || fail backup_failed pack_failed "" "could not pack the paths, see tar's error above"
  if [[ ${#databases[@]} -gt 0 ]]
  then
    tar -rf "$work/backup.tar" -C "$work/snapshots" -- "${databases[@]}" \
      || fail backup_failed pack_failed "" \
              "could not pack the database snapshots, see tar's error above"
  fi
  gzip "$work/backup.tar" \
    || fail backup_failed pack_failed "" "could not compress the archive, see gzip's error above"
}

# The databases in SQLITE_DATABASES that are, or lie within, one of the
# given paths.
databases_within () {
  local db path
  for db in "${SQLITE_DATABASES[@]}"
  do
    for path in "$@"
    do
      if [[ $db == "$path" || $db == "$path"/* ]]
      then
        echo "$db"
        break
      fi
    done
  done
}

# Copy a database, with whatever is still in its -wal file, into a
# consistent snapshot under the same relative path in the given
# directory, and check the snapshot's integrity.
snapshot_database () {
  local db="$1" dir="$2" integrity
  mkdir -p "$(dirname "$dir/$db")"
  sqlite3 -readonly "$HOME/$db" ".backup '$dir/$db'" \
    || fail backup_failed snapshot_failed "database=$db" \
            "could not snapshot $HOME/$db, see sqlite3's error above"
  integrity="$(sqlite3 "$dir/$db" 'PRAGMA integrity_check' 2>&1)"
  if [[ $integrity != ok ]]
  then
    fail backup_failed database_damaged "database=$db" \
         "the snapshot of $HOME/$db fails its integrity check: $integrity"
  fi
}

# Upload a file to a key in the bucket. With --content-md5, S3 itself
# rejects an upload that doesn't match what was sent.
upload () {
  local file="$1" key="$2" version
  version="$(aws s3api put-object --bucket "$BUCKET" --key "$key" \
                 --body "$file" --content-md5 "$(content_md5 "$file")" \
                 --profile "$UPLOAD_PROFILE" --region "$REGION" \
                 --query VersionId --output text)" \
    || fail backup_failed upload_failed "key=$key" \
            "S3 did not confirm the upload of $key, see aws's error above"
  echo "Uploaded s3://$BUCKET/$key, version $version"
}

# The base64 of a file's binary MD5 digest, as S3's Content-MD5 wants it.
content_md5 () {
  local file="$1" hex escaped="" i
  hex="$(md5sum "$file" | cut -d ' ' -f 1)"
  for ((i = 0; i < ${#hex}; i += 2))
  do
    escaped+="\\x${hex:i:2}"
  done
  # shellcheck disable=SC2059 # the format is the digest as \x escapes
  printf "$escaped" | base64
}

# Write the current time to a timestamp file in ~/.local/state/backup:
# one line, seconds since the epoch. bash.sh reads that line;
# backup.service reads last-backup's mtime, so it is written only on
# success.
record_time () {
  local name="$1" dir="$HOME/.local/state/backup"
  mkdir -p "$dir"
  now > "$dir/$name"
}

# The only place this script reads the clock.
now () { date +%s; }

# Report why the command failed, on stderr and in the user journal, and
# end it with a non-zero exit. The journal gets the event, the reason
# and the fields; stderr gets the message.
fail () {
  local event="$1" reason="$2" fields="$3" message="$4"
  echo "backup: $message" >&2
  logger -t backup --id=$$ -p user.err "$event reason=$reason $fields"
  exit 1
}

usage () {
  echo "Usage: backup | backup restore <dir> [--host H] [version-id] [--profile P] | backup setup [--profile P]" >&2
  exit 2
}

main "$@"
