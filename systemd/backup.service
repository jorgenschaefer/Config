[Unit]
Description=Back up this machine's paths to S3

[Service]
Type=oneshot
# The timer also starts a run whenever the user manager starts, i.e. at
# the first login after all sessions ended, so a run that failed and
# was cut off by the end of the session is retried. It goes ahead only
# when no backup has succeeded today, so logins add no versions.
ExecCondition=/bin/sh -c '! find %h/.local/state/backup/last-backup -newermt 00:00 2>/dev/null | grep -q .'
ExecStart=%h/.local/bin/backup
# A failed run is retried until one succeeds. The first retries come
# within minutes, for the run at login that starts before the network
# is up; the delay then grows to an hour, for a machine that stays
# offline.
Restart=on-failure
RestartSec=1min
RestartSteps=6
RestartMaxDelaySec=1h
