[Unit]
Description=Back up this machine's paths to S3 once a day

[Timer]
OnCalendar=daily
# Catch up on a day missed while the machine was off, once the user's
# session starts again.
Persistent=true
# A run at every login, for a failed run whose retries ended with the
# session. backup.service skips it once a backup has succeeded today.
OnStartupSec=1min

[Install]
WantedBy=timers.target
